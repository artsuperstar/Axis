        "task_date_valid": {
          "name": "task_date_valid",
          "value": "\"tasks\".\"date\" IS NULL OR (\n    \"tasks\".\"date\" GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]'\n    AND substr(\"tasks\".\"date\", 1, 4) >= '0001'\n    AND coalesce(strftime('%Y-%m-%d', \"tasks\".\"date\", '+0 days') = \"tasks\".\"date\", 0)\n  )"
        },
        "task_time_valid": {
          "name": "task_time_valid",
          "value": "\"tasks\".\"time\" IS NULL OR (\n    \"tasks\".\"date\" IS NOT NULL\n    AND \"tasks\".\"time\" GLOB '[0-2][0-9]:[0-5][0-9]'\n    AND substr(\"tasks\".\"time\", 1, 2) < '24'\n  )"
        },
