      "checkConstraints": {
        "recurrence_frequency_valid": {
          "name": "recurrence_frequency_valid",
          "value": "\"task_recurrences\".\"frequency\" IN ('daily', 'weekly', 'monthly', 'yearly')"
        },
        "recurrence_interval_valid": {
          "name": "recurrence_interval_valid",
          "value": "\"task_recurrences\".\"interval\" >= 1 AND (\"task_recurrences\".\"frequency\" != 'yearly' OR \"task_recurrences\".\"interval\" = 1)"
        },
        "recurrence_pattern_valid": {
          "name": "recurrence_pattern_valid",
          "value": "CASE \"task_recurrences\".\"frequency\"\n    WHEN 'weekly' THEN \"task_recurrences\".\"weekday_mask\" BETWEEN 1 AND 127 AND \"task_recurrences\".\"month_day\" IS NULL AND \"task_recurrences\".\"month\" IS NULL\n    WHEN 'monthly' THEN \"task_recurrences\".\"weekday_mask\" IS NULL AND \"task_recurrences\".\"month_day\" BETWEEN 1 AND 31 AND \"task_recurrences\".\"month\" IS NULL\n    WHEN 'yearly' THEN \"task_recurrences\".\"weekday_mask\" IS NULL AND \"task_recurrences\".\"month\" BETWEEN 1 AND 12 AND \"task_recurrences\".\"month_day\" BETWEEN 1 AND\n      CASE \"task_recurrences\".\"month\" WHEN 2 THEN 29 WHEN 4 THEN 30 WHEN 6 THEN 30 WHEN 9 THEN 30 WHEN 11 THEN 30 ELSE 31 END\n    ELSE \"task_recurrences\".\"weekday_mask\" IS NULL AND \"task_recurrences\".\"month_day\" IS NULL AND \"task_recurrences\".\"month\" IS NULL\n  END AND CASE \"task_recurrences\".\"frequency\" WHEN 'weekly' THEN \"task_recurrences\".\"weekday_mask\" IS NOT NULL\n    WHEN 'monthly' THEN \"task_recurrences\".\"month_day\" IS NOT NULL\n    WHEN 'yearly' THEN \"task_recurrences\".\"month\" IS NOT NULL AND \"task_recurrences\".\"month_day\" IS NOT NULL ELSE 1 END"
        },
        "recurrence_dates_valid": {
          "name": "recurrence_dates_valid",
          "value": "\n    \"task_recurrences\".\"start_date\" GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]' AND substr(\"task_recurrences\".\"start_date\", 1, 4) >= '0001'\n    AND coalesce(strftime('%Y-%m-%d', \"task_recurrences\".\"start_date\", '+0 days') = \"task_recurrences\".\"start_date\", 0)\n    AND \"task_recurrences\".\"effective_from\" GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]' AND substr(\"task_recurrences\".\"effective_from\", 1, 4) >= '0001'\n    AND coalesce(strftime('%Y-%m-%d', \"task_recurrences\".\"effective_from\", '+0 days') = \"task_recurrences\".\"effective_from\", 0)\n    AND (\"task_recurrences\".\"end_date\" IS NULL OR (\"task_recurrences\".\"end_date\" >= \"task_recurrences\".\"start_date\"\n      AND \"task_recurrences\".\"end_date\" GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]'\n      AND coalesce(strftime('%Y-%m-%d', \"task_recurrences\".\"end_date\", '+0 days') = \"task_recurrences\".\"end_date\", 0)))\n    AND (\"task_recurrences\".\"effective_until\" IS NULL OR (\"task_recurrences\".\"effective_until\" > \"task_recurrences\".\"effective_from\"\n      AND \"task_recurrences\".\"effective_until\" GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]'\n      AND coalesce(strftime('%Y-%m-%d', \"task_recurrences\".\"effective_until\", '+0 days') = \"task_recurrences\".\"effective_until\", 0)))"
        },
        "recurrence_time_valid": {
          "name": "recurrence_time_valid",
          "value": "\"task_recurrences\".\"scheduled_time\" IS NULL OR (\"task_recurrences\".\"scheduled_time\" GLOB '[0-2][0-9]:[0-5][0-9]' AND substr(\"task_recurrences\".\"scheduled_time\", 1, 2) < '24')"
        },
        "recurrence_updated_after_created": {
          "name": "recurrence_updated_after_created",
          "value": "\"task_recurrences\".\"updated_at\" >= \"task_recurrences\".\"created_at\""
        }
